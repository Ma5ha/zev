{
  "name": "@zev/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Nx monorepo za ZEV web i mobilne aplikacije",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "nx": "nx",
    "projects": "nx show projects",
    "graph": "nx graph",
    "report": "nx report",
    "dev": "nx dev web",
    "build": "nx build web",
    "lint": "nx lint web",
    "typecheck": "nx typecheck web",
    "start": "nx start web",
    "db:start": "supabase start --network-id zev-staging-local",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "supabase migration up --local",
    "db:lint": "supabase db lint --local",
    "db:network": "docker network create --driver bridge --opt com.docker.network.bridge.host_binding_ipv4=127.0.0.1 zev-staging-local",
    "db:seed-users": "node scripts/seed-local-identities.mjs",
    "web:configure-local": "node scripts/configure-local-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/next": "23.3.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "nx": "23.3.0",
    "postcss": "^8.5.6",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@radix-ui/react-select": "2.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tabler/icons-react": "3.49.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
