# Local only. Generate actual ignored .env.local with pnpm web:configure-local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
# Server only, needed for sending invitations; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status
APP_ORIGIN=http://127.0.0.1:3000
